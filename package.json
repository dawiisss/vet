{
  "name": "vet",
  "desktopName": "vet.desktop",
  "version": "1.5.0",
  "description": "A feature-rich terminal emulator",
  "author": "Vet Team <vet@route2place.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawiisss/vet.git"
  },
  "keywords": [
    "terminal",
    "emulator",
    "electron",
    "xterm"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint .",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.vet.app",
    "productName": "Vet",
    "publish": {
      "provider": "github",
      "owner": "dawiisss",
      "repo": "vet"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "rpm",
        "pacman"
      ],
      "desktop": {
        "entry": {
          "Name": "Vet",
          "Comment": "Very Easy Terminal Emulator",
          "Categories": "Utility;System;TerminalEmulator;",
          "StartupWMClass": "vet"
        }
      }
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "json5": "^2.2.3",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0",
    "tldts-experimental": "^7.4.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^30.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.7.0",
    "cpu-features": "file:./stubs/cpu-features-0.0.10.tgz",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "nan": "^2.22.0",
    "esbuild": "^0.28.1",
    "cpu-features": "$cpu-features",
    "js-yaml": "^4.2.0",
    "form-data": "^4.0.6",
    "undici": "^7.28.0",
    "brace-expansion": "^5.0.7",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.7"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "electron-winstaller@5.4.0": true
  }
}
